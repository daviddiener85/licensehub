DATABASE_URL="postgresql://license_hub:license_hub@localhost:5432/license_hub?schema=public"

# Use test keys while Paystack is in review and during local development.
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
# Optional override for webhook signature verification; otherwise the secret key is used.
PAYSTACK_WEBHOOK_SECRET=""

SMS_PROVIDER_API_KEY=""
EMAIL_PROVIDER_API_KEY=""

WHATSAPP_PROVIDER="meta_cloud_api"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v23.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Required for delivery-status webhook calls to be accepted; unsigned requests are rejected.
WHATSAPP_APP_SECRET=""

APP_BASE_URL="https://www.lichub.co.za"
ADMIN_ACCESS_KEY=""
SUPPLIER_ACCESS_KEY=""

OPENAI_API_KEY=""
# Optional override for licence disk image extraction. Defaults to gpt-5-mini.
OPENAI_LICENSE_DISK_MODEL="gpt-5-mini"

# Base64-encoded 32-byte AES-GCM key for decrypting stored client ID numbers server-side.
# Used only when generating protected mandate PDFs; browser previews remain masked.
CLIENT_ID_ENCRYPTION_KEY=""

# Retention deletion runs inside the long-lived web service so it can access the attached upload disk.
RETENTION_PURGE_ENABLED="false"
RETENTION_PURGE_INTERVAL_HOURS="24"
RETENTION_PURGE_START_DELAY_SECONDS="60"
RETENTION_PURGE_BATCH_SIZE="25"
